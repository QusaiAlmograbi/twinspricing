PORT=3000
NODE_ENV=production

# رابط PostgreSQL في Render أو أي بيئة إنتاج.
DATABASE_URL=

JWT_SECRET=

# Origins المسموح بها لـ CORS (مفصولة بفواصل). اتركه فاضي للسماح بـ localhost فقط.
# مثال: https://your-app.onrender.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Company info for PDF
COMPANY_NAME=Your Company Name
COMPANY_TAGLINE=YOUR TAGLINE
COMPANY_ADDRESS=Your Address
COMPANY_WEBSITE=www.yourwebsite.com
COMPANY_EMAIL=contact@yourwebsite.com
COMPANY_PHONE=+1 234 567 890
COMPANY_INSTAGRAM=your_instagram
